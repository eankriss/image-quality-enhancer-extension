{
  "manifest_version": 3,
  "name": "Image Quality Enhancer",
  "version": "1.0.0",
  "description": "Enhance image quality, preview before/after, resize, and export as PNG, JPEG, or WebP.",
  "action": {
    "default_title": "Open Image Quality Enhancer"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}